<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- AAOS 차량 속성(기어·속도·방향지시등) -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_LIGHTS" />
    <!-- Pleos Vehicle SDK·NaviHelper (공식 샘플과 같은 권한) -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_SPEED" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <!-- Android 11+ 패키지 가시성: TTS 엔진 찾기 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="G1B Probe">

        <uses-library android:name="android.car" android:required="false" />

        <!-- 정차 화면: DO 선언 없음 -->
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 주행 중 상태 화면: DO 선언 (B1에서 실제로 받아들여지는지 확인) -->
        <activity android:name=".GlanceStatusActivity" android:exported="true">
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>

        <!-- 음성·차량 신호·경로를 맡는 포그라운드 서비스 (화면이 가려져도 동작하는지 B3에서 확인) -->
        <service
            android:name=".ProbeService"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="driving companion voice probe" />
        </service>
    </application>
</manifest>
